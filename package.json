{
  "name": "vatlas",
  "private": true,
  "version": "2.1.4",
  "type": "module",
  "description": "Drop your RVTools export, get a navigable visual atlas of your VMware estate. 100% client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/check-supply-chain.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "generate-mib-canary": "node scripts/generate-mib-canary.mjs",
    "generate-inventory-10k": "node scripts/generate-inventory-10k.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync:eos": "node scripts/sync-eos.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.9",
    "sonner": "^2.0.8",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "size-sensor": "1.0.3",
    "fast-uri": "^3.1.9",
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
